{
  "name": "Workload B",
  "description": "Read heavy workload - 95% reads, 5% updates",
  "workload_type": "b",
  "operations": {
    "read": {
      "proportion": 0.95,
      "description": "Read individual cart by customerId"
    },
    "update": {
      "proportion": 0.05,
      "description": "Update cart item quantities"
    }
  },
  "use_case": "Photo tagging - add a tag is an update, but most operations are reads",
  "distribution": "zipfian",
  "default_operation_count": 10000,
  "request_distribution": {
    "type": "zipfian",
    "theta": 0.99
  },
  "field_length": {
    "min": 1,
    "max": 100
  },
  "insert_order": "hashed",
  "read_modify_write_proportion": 0.0,
  "scan_length_distribution": "uniform",
  "max_scan_length": 1000,
  "core_workload": true,
  "notes": [
    "This workload has a read-heavy mix of 95/5 reads and updates",
    "Application example: Photo tagging application",
    "Most operations are reads with occasional tag additions",
    "Good for testing read throughput and caching effectiveness"
  ],
  "performance_targets": {
    "read_latency_p95_ms": 5,
    "update_latency_p95_ms": 15,
    "throughput_ops_sec": 50000
  },
  "caching_recommendations": {
    "cache_size_percent": 20,
    "cache_policy": "LRU",
    "read_ahead": true
  }
}
