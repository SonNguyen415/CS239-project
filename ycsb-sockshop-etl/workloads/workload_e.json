{
  "name": "Workload E",
  "description": "Scan heavy workload - 95% scans, 5% inserts",
  "workload_type": "e",
  "operations": {
    "scan": {
      "proportion": 0.95,
      "description": "Scan ranges of cart records"
    },
    "insert": {
      "proportion": 0.05,
      "description": "Insert new cart records"
    }
  },
  "use_case": "Threaded conversations - users scanning ranges, occasional new messages",
  "distribution": "uniform",
  "default_operation_count": 5000,
  "request_distribution": {
    "type": "uniform"
  },
  "field_length": {
    "min": 1,
    "max": 100
  },
  "insert_order": "ordered",
  "read_modify_write_proportion": 0.0,
  "scan_length_distribution": "uniform",
  "scan_length": {
    "min": 1,
    "max": 100,
    "default": 10
  },
  "max_scan_length": 100,
  "core_workload": true,
  "notes": [
    "This workload is scan-intensive with 95/5 scans and inserts",
    "Application example: Threaded conversation applications",
    "Users frequently scan ranges of records",
    "Tests range query performance and sequential I/O patterns",
    "Insert rate is low but continuous"
  ],
  "performance_targets": {
    "scan_latency_p95_ms": 50,
    "insert_latency_p95_ms": 20,
    "throughput_ops_sec": 5000,
    "scan_throughput_records_sec": 50000
  },
  "database_recommendations": {
    "index_strategy": "compound_indexes",
    "optimize_for": "range_queries",
    "compression": true,
    "block_size": "large"
  },
  "scan_patterns": {
    "forward_scans": 0.8,
    "reverse_scans": 0.2,
    "random_seeks": false
  }
}
