{
  "dashboard": {
    "title": "YCSB Benchmark Results",
    "tags": ["ycsb", "benchmark", "mongodb"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Throughput (ops/sec)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "ycsb_throughput_ops_sec",
            "legendFormat": "Throughput"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Operations/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Total Operations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "ycsb_read_operations_total",
            "legendFormat": "READ Operations"
          },
          {
            "expr": "ycsb_update_operations_total",
            "legendFormat": "UPDATE Operations"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Operations"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "READ Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "ycsb_read_latency_avg_us",
            "legendFormat": "Average"
          },
          {
            "expr": "ycsb_read_latency_95th_us",
            "legendFormat": "95th Percentile"
          },
          {
            "expr": "ycsb_read_latency_99th_us",
            "legendFormat": "99th Percentile"
          },
          {
            "expr": "ycsb_read_latency_max_us",
            "legendFormat": "Maximum"
          }
        ],
        "yaxes": [
          {"format": "µs", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "UPDATE Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "ycsb_update_latency_avg_us",
            "legendFormat": "Average"
          },
          {
            "expr": "ycsb_update_latency_95th_us",
            "legendFormat": "95th Percentile"
          },
          {
            "expr": "ycsb_update_latency_99th_us",
            "legendFormat": "99th Percentile"
          },
          {
            "expr": "ycsb_update_latency_max_us",
            "legendFormat": "Maximum"
          }
        ],
        "yaxes": [
          {"format": "µs", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Runtime",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "ycsb_runtime_ms",
            "legendFormat": "Runtime"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "id": 6,
        "title": "Average READ Latency",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
        "targets": [
          {
            "expr": "ycsb_read_latency_avg_us",
            "legendFormat": "Avg READ"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "µs"
          }
        }
      },
      {
        "id": 7,
        "title": "Average UPDATE Latency",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "ycsb_update_latency_avg_us",
            "legendFormat": "Avg UPDATE"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "µs"
          }
        }
      },
      {
        "id": 8,
        "title": "Current Throughput",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
        "targets": [
          {
            "expr": "ycsb_throughput_ops_sec",
            "legendFormat": "Throughput"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      }
    ],
    "refresh": "5s",
    "time": {
      "from": "now-5m",
      "to": "now"
    }
  }
}